{
  "name": "judgemind-api",
  "version": "0.1.0",
  "private": true,
  "description": "Judgemind GraphQL + REST API",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ tests/ --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run --passWithNoTests .unit.test",
    "test:integration": "vitest run --passWithNoTests .integration.test",
    "test:watch": "vitest",
    "db:migrate": "tsc && node scripts/seed-and-migrate.mjs",
    "db:migrate:down": "node-pg-migrate down --no-timestamp",
    "db:migrate:create": "node-pg-migrate create --migration-file-language sql --no-timestamp"
  },
  "dependencies": {
    "@apollo/server": "^4.10",
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/client-ses": "^3.1039.0",
    "@aws-sdk/credential-provider-node": "^3.972.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.2.3",
    "fastify": "^5.8",
    "google-auth-library": "^9.15.1",
    "graphql": "^16.8",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^1.1.0",
    "jsonwebtoken": "^9.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.11",
    "pino": "^9",
    "redis": "^5",
    "zod": "^3.22"
  },
  "devDependencies": {
    "@types/bcrypt": "^5",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "globals": "^16",
    "tsx": "^4.7",
    "typescript": "^5.4",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
