{
  "model": "opus",
  "permissions": {
    "deny": ["NotebookEdit", "Task(Bash)"],
    "allow": [
      "WebFetch(domain:dev.api.judgemind.org)",
      "WebFetch(domain:dev.judgemind.org)",
      "WebFetch(domain:api.judgemind.org)",
      "WebFetch(domain:judgemind.org)",
      "Edit(**)",
      "Write(**)",
      "Write(/tmp/*)",
      "Glob",
      "Grep",
      "Skill",
      "Bash(git *)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(gh api*)",
      "Bash(gh secret*)",
      "Bash(gh label*)",
      "Bash(gh project*)",
      "Bash(gh auth*)",
      "Bash(gh run*)",
      "Bash(gh workflow*)",
      "Bash(gh search*)",
      "Bash(.venv/bin/*)",
      "Bash(**/.venv/bin/*)",
      "Bash(scripts/*)",
      "Bash(**/scripts/*)",
      "Bash(source *)",
      "Bash(chmod +x *)",
      "Bash(python*)",
      "Bash(brew *)",
      "Bash(terraform *)",
      "Bash(vercel *)",
      "Bash(aws *)",
      "Bash(curl *)",
      "Bash(dig *)",
      "Bash(tar *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm -rf */worktrees/*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(pwd *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(which *)",
      "Bash(realpath *)",
      "Bash(dirname *)",
      "Bash(basename *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(yarn *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/preflight-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/orchestrator-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-end.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
