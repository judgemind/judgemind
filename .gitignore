# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
# Dispatcher daemon venv (created by scripts/install-dispatcher-venv.sh)
scripts/dispatcher/.venv/
# Dispatcher v3 task-runner venv (created by scripts/install-dispatcher-v3-venv.sh)
scripts/dispatcher_v3/.venv/
.venv-scripts/
venv/

# Build outputs
dist/
build/
.next/
*.egg-info/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment & secrets
.claude/settings.local.json
.env
.env.local
.env.*.local
*.pem
*.key

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
infra/terraform/modules/**/placeholder.zip
# Module test fixtures need `terraform init` for plan-time check coverage,
# which writes `.terraform.lock.hcl`. The lock file is per-machine and not
# meant to be committed -- existing fixtures (dispatcher-daemon, api-service,
# compute, etc.) intentionally don't track it.
infra/terraform/modules/**/tests/**/.terraform.lock.hcl

# OS
.DS_Store
Thumbs.db

# Test & coverage
coverage/
htmlcov/
.coverage
.coverage.*
coverage.xml
lcov.info
.pytest_cache/
.testmondata
.testmondata-journal

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# Agent worker temp files
tmp/

# Eval script results (run-specific, not committed)
scripts/eval/results/

# Scraped data (never commit raw court data)
data/
*.html.raw
*.pdf.raw

# Agent temp files (per-worktree scratch space)
tmp/

# Agent worktrees (isolated git worktrees, never committed)
worktrees/

# Agent lock files (per-worktree, ephemeral)
.agent-lock
.claude/scheduled_tasks.lock

# Vite cache
.vite/

# Task-claim agent_id sidecar (pre-#2927 — kept to ignore any
# historical files lingering on dev machines; the current
# label-only /task flow no longer writes this file).
.task-agent-id
